{
  "goals": {
    "type": "object",
    "properties": {
      "goals": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "goal_id": {
              "type": "string",
              "minLength": 1
            },
            "goal_type": {
              "enum": [
                "SEEK",
                "ACT",
                "MIXED"
              ],
              "type": "string"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "depends_on": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "completion_condition": {
              "type": "string",
              "minLength": 1
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "goal_id",
            "goal_type",
            "description",
            "depends_on",
            "source_ids",
            "constraints",
            "completion_condition"
          ],
          "additionalProperties": false
        }
      },
      "issues": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "goals",
      "issues"
    ],
    "additionalProperties": false
  },
  "alignment": {
    "type": "object",
    "properties": {
      "ranges": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "first": {
              "type": "integer",
              "minimum": 0
            },
            "last": {
              "type": "integer",
              "minimum": 0
            },
            "goal_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "status": {
              "enum": [
                "ALIGNED",
                "SUPPORT_NO_GOAL",
                "OFF_GOAL",
                "UNRESOLVED"
              ],
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "first",
            "last",
            "goal_ids",
            "status",
            "reason"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "ALIGNED"
                  }
                }
              },
              "then": {
                "properties": {
                  "goal_ids": {
                    "minItems": 1,
                    "maxItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "SUPPORT_NO_GOAL",
                      "OFF_GOAL"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "goal_ids": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    "required": [
      "ranges"
    ],
    "additionalProperties": false
  },
  "operator": {
    "type": "object",
    "properties": {
      "units": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "unit_index": {
              "type": "integer",
              "minimum": 0
            },
            "operator": {
              "enum": [
                "INSPECT",
                "COMMIT",
                "LEAVE",
                "EXECUTE",
                "SUPPORT",
                "UNRESOLVED"
              ],
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "unit_index",
            "operator",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "units"
    ],
    "additionalProperties": false
  }
}
